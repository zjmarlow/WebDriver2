use Test;

use lib 'lib';

use WD2;
use WD2::Wait;
use WD2::Wait::Common :alert;
use WD2::Test::Template;
use WD2::Endpoints;
use WD2::Locators;

my IO::Path:D $html-file = $*CWD.add: <xt content alert.html>;

class Wait does WD2::Test::Template {
	has Int:D $.plan = 5;
	has Str:D $.name = 'wait-alert';
	has Str:D $.description = 'wait alert';
	
	method pre-test { }
	method post-test { }

	method init {
		if %*ENV<DRIVER_TESTING> {
			self.WD2::Test::Template::init;
		} else {
			plan 1;
			diag "DRIVER_TESTING was not set";
			skip-rest("DRIVER_TESTING was not set");
			exit;
		}
	}
	
	method test {
		my Duration:D $duration = Duration.new: 2;
		my Duration:D $threshold = Duration.new: 1/2;
		my By:D $immediate = By.id: 'immediate';
		my By:D $delayed   = By.id: 'delayed';
		my Str $text;
		my &wait;
		my WD2::Component::Element $element;
		my Instant $start;
		
		$!session.navigate-to: 'file://' ~ $html-file.absolute;
		self.throws-like:
				'no alert present; hard wait',
				WD2::Wait::Timeout::X,
				alert $!session, :$duration
				;
		
		self.nok:
				'no alert present; soft wait',
				.() with alert $!session, :$duration, :soft
				;
		
		$element = $!session.find-element: $immediate;
		$element.click;
		$start = now;
		$text = .() with alert $!session;
		self.ok: 'immediate return for existing alert', now - $start < $threshold;
		self.is: 'correct text', 'immediate', $text;
		$!session.accept-alert;
		
		$element = $!session.find-element: $delayed;
		$element.click;
		self.is: 'wait for alert', 'delayed', .() with alert $!session;
		$!session.accept-alert;
	}
	
	method element-by-id( Str $id ) {
		$!session.find-element( By.id: $id )
	}
}

constant &MAIN = driver-test Wait;


